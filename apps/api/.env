# ==============================================================================
# PesquisaMaster - Configuração de Conexão Local PostgreSQL & PostGIS
# ==============================================================================

# Credenciais do PostgreSQL Local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pesquisas

# URL de Conexão Assíncrona para SQLAlchemy 2.0 (FastAPI + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/pesquisas

# URL de Conexão Síncrona (Alembic / Migrações / Scripts CLI)
SYNC_DATABASE_URL=postgresql://postgres:123456@localhost:5432/pesquisas

# Configuração do Redis Local
REDIS_URL=redis://localhost:6379/0

# Parâmetros da Aplicação
ENVIRONMENT=development
DEBUG=true
APP_NAME=PesquisaMaster API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Segurança e Autenticação (JWT + HMAC)
JWT_SECRET_KEY=dev-only-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
HMAC_FIELD_SECRET=dev-only-hmac-field-secret-change-in-production-32-chars

