# Exemplo de configuração local para PesquisaMaster API
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pesquisamaster

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pesquisamaster
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pesquisamaster
REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=development
DEBUG=true
APP_NAME=PesquisaMaster API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

JWT_SECRET_KEY=dev-only-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
HMAC_FIELD_SECRET=dev-only-hmac-field-secret-change-in-production-32-chars

